# Copy to api/.env and configure your OpenAI key. SQL Assistant app storage is created automatically by start.sh.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3003,http://127.0.0.1:3003
# Leave these blank; start.sh creates a private Docker PostgreSQL store and credentials on first run.
SQL_ASSISTANT_POSTGRES_PASSWORD=
APP_DATABASE_URL=
# Optional. If omitted, SQL Assistant creates a local persistent Fernet key in api/.encryption.key.
APP_ENCRYPTION_KEY=
